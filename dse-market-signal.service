[Unit]
Description=DSE Market Signal - Autonomous Real-time Engine
After=network.target

[Service]
Type=simple
User=dseuser
Group=dseuser
WorkingDirectory=/opt/dse-market-signal
Environment="PATH=/opt/dse-market-signal/.venv/bin:/usr/local/bin:/usr/bin"
Environment="TZ=Asia/Dhaka"
ExecStart=/opt/dse-market-signal/.venv/bin/uvicorn backend.main:app --host 0.0.0.0 --port 8000 --workers 1
Restart=always
RestartSec=5s

# Security Hardening
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
