{
  "app_name": "DSE Market Signal",
  "version": "2.0.0",
  "timezone": "Asia/Dhaka",
  "market": {
    "provider": "DSE",
    "source": "legacy",
    "api_key_required": false,
    "symbols": ["GP", "BATBC", "SQURPHARMA", "BEXIMCO", "ROBI"],
    "historical_months": 6,
    "batch_days": 7
  },
  "scheduler": {
    "auto_collection": true,
    "time": "16:30",
    "intraday_hourly": true,
    "intraday_market_hours": "10:00 - 14:00",
    "intraday_days": "Sunday-Thursday",
    "timezone": "Asia/Dhaka",
    "retry_failed": true,
    "missing_data_recovery": true
  },
  "risk": {
    "max_portfolio_drawdown_pct": 10.0,
    "max_concurrent_positions": 5,
    "max_single_stock_allocation_pct": 25.0,
    "min_risk_reward_ratio": 1.5,
    "default_risk_per_trade_pct": 2.0,
    "default_trailing_stop_pct": 5.0
  },
  "skills": {
    "enabled": ["trend_following", "breakout_detection", "mean_reversion"],
    "min_confidence_threshold": 60
  }
}

